"ctrl_pressed": true
}]
}
}, {
"text": "Exportar PNG",
"id": 3
}, {
"text": "Exportar JPG",
"id": 4
}]

[node name="MenuButton_Edit" type="MenuButton" parent="MainUI/MarginContainer/VBoxContainer/TopPanel/MenuBar"]
