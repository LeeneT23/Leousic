[node name="ToolBar" type="HBoxContainer" parent="MainUI/MarginContainer/VBoxContainer/TopPanel"]
layout_mode = 2
theme_override_constants/separation = 4
alignment = 1

[node name="ToolButton_Brush" type="Button" parent="MainUI/MarginContainer/VBoxContainer/TopPanel/ToolBar"]
