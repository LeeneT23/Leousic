[gd_scene load_steps=2 format=3 uid="uid://main_scene"]

[sub_resource type="GDScript" id="GDScript_main"]
script/path = "res://Scripts/Main.cs"

[node name="Main" type="Node"]
script = SubResource("GDScript_main")

[node name="MainUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_mainui")

[node name="MarginContainer" type="MarginContainer" parent="MainUI"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 0
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 0
theme_override_constants/margin_bottom = 0

[node name="VBoxContainer" type="VBoxContainer" parent="MainUI/MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="TopPanel" type="HBoxContainer" parent="MainUI/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 4
minimum_size_y = 60

[node name="MenuBar" type="HBoxContainer" parent="MainUI/MarginContainer/VBoxContainer/TopPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MenuButton_File" type="MenuButton" parent="MainUI/MarginContainer/VBoxContainer/TopPanel/MenuBar"]
custom_minimum_size/x = 80
text = "Archivo"
menu/items = [{
